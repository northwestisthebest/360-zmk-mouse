/*
 * 360 Mouse - parts shared by every PCB revision.
 * Pins, sensor orientation and per-copy tuning live in the variant overlays.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &default_layout;
        zmk,battery = &vbatt;
        zephyr,boot-mode = &boot_retention;
        zmk,magic-boot-mode = &adafruit_boot_retention;
    };

    /* input-gpios set per variant; order = key positions 0..5:
       left, middle, right, MB4, MB5, space */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)>;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "360 Mouse";
        transform = <&default_transform>;
        keys  //                     w    h    x    y   rot   rx   ry
            = <&key_physical_attrs 100  100    0    0     0    0    0>
            , <&key_physical_attrs 100  100  100    0     0    0    0>
            , <&key_physical_attrs 100  100  200    0     0    0    0>
            , <&key_physical_attrs 100  100  300    0     0    0    0>
            , <&key_physical_attrs 100  100  400    0     0    0    0>
            , <&key_physical_attrs 100  100  500    0     0    0    0>;
    };

    /* the trackball node itself is defined in each variant (pins differ) */
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };

#include <dt-bindings/zmk/keys.h>   /* after the matrix map: keys.h redefines RC() */

    /* io-channels, mv-mid and invert set per variant via &x_ch / &y_ch */
    anin0: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <250>;
        /* Pot supply from P0.09 (D10), high only while sampling. Every
           variant uses the same pin. A mouse whose pots are still on 3.3 V
           just toggles an unconnected pin - harmless. */
        power-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>;
        mv-top = <3200>;           /* re-measure on a gated mouse, see README */
        game-layer = <2>;          /* joystick sends WASD while layer 2 is on */
        x_ch: x-ch {
            mv-min-max = <1450>;
            mv-deadzone = <200>;
            scale-multiplier = <1>;
            scale-divisor = <30000>;
            input-code = <INPUT_REL_HWHEEL>;
            evt-type = <INPUT_EV_REL>;
            game-key-pos = <D>;    /* same direction as scrolling right */
            game-key-neg = <A>;
        };
        y_ch: y-ch {
            mv-min-max = <1400>;
            mv-deadzone = <200>;
            scale-multiplier = <1>;
            scale-divisor = <30000>;
            input-code = <INPUT_REL_WHEEL>;
            evt-type = <INPUT_EV_REL>;
            game-key-pos = <W>;    /* same direction as scrolling up */
            game-key-neg = <S>;
        };
    };

    anin0_listener: anin0_listener {
        compatible = "zmk,input-listener";
        device = <&anin0>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    magic_mapper {
        compatible = "zmk,bootmode-to-magic-mapper";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <1>;
        boot_retention: retention@0 {
            compatible = "zephyr,retention";
            status = "okay";
            reg = <0x0 0x1>;
        };
    };

    /* gpios set per variant */
    led_indicator: led_indicator {
        compatible = "zmk,led-indicator";
        indicate-layer = <1>;
        blink-layers = <2 3>;      /* into game: 2 blinks, into RMB lock: 3; out: 1 */
        activity-device = <&trackball>;
        activity-hold-ms = <60>;
    };
};

&adc {
    status = "okay";
};

&gpregret1 {
    adafruit_boot_retention: retention@0 {
        compatible = "zephyr,retention";
        status = "okay";
        reg = <0x0 0x1>;
    };
};
