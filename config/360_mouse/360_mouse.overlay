#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 1, 11)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 1, 11)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <250000>;
        irq-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_Y>;
        y-input-code = <INPUT_REL_X>;
    };
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        input-gpios =
            <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  /* pos 0: left   - P0.17 */
            <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  /* pos 1: middle - P0.22 */
            <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  /* pos 2: right  - P0.24 */
            <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  /* pos 3: MB4    - P0.31 */
            <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  /* pos 4: MB5    - P0.11 */
            <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* pos 5: space  - P1.04 */
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)>;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "360 Mouse";
        transform = <&default_transform>;
        keys  //                     w    h    x    y   rot   rx   ry
            = <&key_physical_attrs 100  100    0    0     0    0    0>
            , <&key_physical_attrs 100  100  100    0     0    0    0>
            , <&key_physical_attrs 100  100  200    0     0    0    0>
            , <&key_physical_attrs 100  100  300    0     0    0    0>
            , <&key_physical_attrs 100  100  400    0     0    0    0>
            , <&key_physical_attrs 100  100  500    0     0    0    0>;
    };
};

&adc {
    status = "okay";
};

/ {
    anin0: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <100>;
        x-ch {
            io-channels = <&adc 0>;
            mv-mid = <1566>;
            mv-min-max = <1550>;
            mv-deadzone = <40>;
            scale-multiplier = <1>;
            scale-divisor = <4000>;
            input-code = <INPUT_REL_HWHEEL>;   /* x-ch */
            evt-type = <INPUT_EV_REL>;
        };
        y-ch {
            io-channels = <&adc 5>;
            mv-mid = <1629>;
            mv-min-max = <1600>;
            mv-deadzone = <40>;
            scale-multiplier = <1>;
            scale-divisor = <4000>;
            input-code = <INPUT_REL_WHEEL>;    /* y-ch */
            evt-type = <INPUT_EV_REL>;
        };
    };

    anin0_listener: anin0_listener {
        compatible = "zmk,input-listener";
        device = <&anin0>;
    };
};
